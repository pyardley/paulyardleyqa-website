---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  readingTime?: string;
}

const { title, description, pubDate, updatedDate, author, tags, readingTime } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Paul Yardley QA`} description={description}>
  <article class="py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Article Header -->
      <header class="mb-12">
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium rounded-full bg-teal/10 text-teal">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold text-slate-800 dark:text-white mb-4 leading-tight">
          {title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
          <span>{author}</span>
          <span class="w-1 h-1 rounded-full bg-slate-400" aria-hidden="true"></span>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {readingTime && (
            <>
              <span class="w-1 h-1 rounded-full bg-slate-400" aria-hidden="true"></span>
              <span>{readingTime}</span>
            </>
          )}
        </div>

        {updatedDate && (
          <p class="mt-2 text-sm text-slate-400 dark:text-slate-500 italic">
            Updated: <time datetime={updatedDate.toISOString()}>{formattedUpdatedDate}</time>
          </p>
        )}
      </header>

      <!-- Article Content -->
      <div class="prose prose-slate dark:prose-invert prose-lg max-w-none
        prose-headings:font-bold prose-headings:text-slate-800 dark:prose-headings:text-white
        prose-a:text-teal prose-a:no-underline hover:prose-a:underline
        prose-code:text-teal prose-code:bg-slate-100 dark:prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
        prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-700
        prose-img:rounded-lg prose-img:shadow-lg
        prose-table:border-collapse prose-th:bg-slate-100 dark:prose-th:bg-slate-800
        prose-td:border prose-td:border-slate-200 dark:prose-td:border-slate-700 prose-td:px-4 prose-td:py-2
        prose-th:border prose-th:border-slate-200 dark:prose-th:border-slate-700 prose-th:px-4 prose-th:py-2">
        <slot />
      </div>

      <!-- Back to Blog -->
      <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-700">
        <a href="/blog" class="inline-flex items-center text-teal hover:underline font-medium">
          <svg class="mr-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to all articles
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
