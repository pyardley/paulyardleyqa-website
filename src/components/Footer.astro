---
const currentYear = new Date().getFullYear();
---

<footer transition:persist class="bg-navy dark:bg-slate-950 text-slate-300 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <a href="/" class="text-xl font-bold text-white hover:text-teal transition-colors">
          Paul Yardley<span class="text-teal">QA</span>
        </a>
        <p class="mt-2 text-sm text-slate-400">
          QA Analyst & Test Engineer based in the UK. Building quality into every release.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-teal transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-teal transition-colors">About</a></li>
          <li><a href="/skills" class="hover:text-teal transition-colors">Skills</a></li>
          <li><a href="/portfolio" class="hover:text-teal transition-colors">Portfolio</a></li>
          <li><a href="/blog" class="hover:text-teal transition-colors">Blog</a></li>
          <li><a href="/resume" class="hover:text-teal transition-colors">Resume</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Connect</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://www.linkedin.com/in/paul-yardley-16731717/" target="_blank" rel="noopener noreferrer" class="hover:text-teal transition-colors">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://github.com/pyardley" target="_blank" rel="noopener noreferrer" class="hover:text-teal transition-colors">
              GitHub
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-teal transition-colors">Contact Me</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-400">
      <p>&copy; {currentYear} Paul Yardley. All rights reserved.</p>
      <p class="flex items-center gap-1">
        <span class="inline-block w-2 h-2 rounded-full bg-green-500" aria-hidden="true"></span>
        Tested by the owner &mdash; Lighthouse &#8805; 95
      </p>
    </div>
  </div>
</footer>
