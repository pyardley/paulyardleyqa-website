---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog — Paul Yardley QA" description="Articles on test automation, accessibility, CI/CD, and quality engineering by Paul Yardley.">
  <section class="py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-slate-800 dark:text-white mb-4">Blog</h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 mb-12 max-w-2xl">
        Thoughts on testing, automation, accessibility, and quality engineering.
      </p>

      <!-- Placeholder for Phase 2 content collection -->
      <div class="bg-slate-100 dark:bg-slate-800 rounded-xl p-12 text-center border-2 border-dashed border-slate-300 dark:border-slate-600">
        <p class="text-slate-500 dark:text-slate-400 text-lg">
          Blog posts coming soon — Phase 2 content.
        </p>
        <p class="text-sm text-slate-400 dark:text-slate-500 mt-2">
          First articles planned: "How I Cut Regression Time by 81% with Playwright + GitHub Actions" and "The 2026 Accessibility Testing Checklist".
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
