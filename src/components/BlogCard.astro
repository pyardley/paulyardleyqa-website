---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  readingTime?: string;
}

const { title, description, pubDate, tags, slug, readingTime } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-teal/50 transition-all duration-300 hover:shadow-lg hover:shadow-teal/5">
  <a href={`/blog/${slug}`} class="block p-6">
    <div class="flex flex-wrap gap-2 mb-3">
      {tags.slice(0, 3).map((tag) => (
        <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-teal/10 text-teal">
          {tag}
        </span>
      ))}
    </div>

    <h2 class="text-xl font-bold text-slate-800 dark:text-white mb-2 group-hover:text-teal transition-colors">
      {title}
    </h2>

    <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-3">
      {description}
    </p>

    <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {readingTime && <span>{readingTime}</span>}
    </div>
  </a>
</article>
