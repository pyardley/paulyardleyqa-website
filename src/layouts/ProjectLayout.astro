---
import BaseLayout from './BaseLayout.astro';

interface Result {
  metric: string;
  value: string;
}

interface Props {
  title: string;
  description: string;
  industry: string;
  role: string;
  duration: string;
  tools: string[];
  scope: string[];
  results?: Result[];
}

const { title, description, industry, role, duration, tools, scope, results } = Astro.props;
---

<BaseLayout title={`${title} — Paul Yardley QA`} description={description}>
  <article class="py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Project Header -->
      <header class="mb-12">
        <h1 class="text-3xl sm:text-4xl font-bold text-slate-800 dark:text-white mb-4 leading-tight">
          {title}
        </h1>

        <p class="text-lg text-slate-600 dark:text-slate-300 mb-6">{description}</p>

        <!-- Meta Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
          <div class="bg-slate-100 dark:bg-slate-800/50 rounded-lg p-4">
            <p class="text-xs font-semibold text-teal uppercase tracking-wide mb-1">Industry</p>
            <p class="text-slate-800 dark:text-white font-medium">{industry}</p>
          </div>
          <div class="bg-slate-100 dark:bg-slate-800/50 rounded-lg p-4">
            <p class="text-xs font-semibold text-teal uppercase tracking-wide mb-1">Role</p>
            <p class="text-slate-800 dark:text-white font-medium">{role}</p>
          </div>
          <div class="bg-slate-100 dark:bg-slate-800/50 rounded-lg p-4">
            <p class="text-xs font-semibold text-teal uppercase tracking-wide mb-1">Duration</p>
            <p class="text-slate-800 dark:text-white font-medium">{duration}</p>
          </div>
        </div>

        <!-- Tools -->
        <div class="mb-6">
          <p class="text-xs font-semibold text-teal uppercase tracking-wide mb-2">Tools & Frameworks</p>
          <div class="flex flex-wrap gap-2">
            {tools.map((tool) => (
              <span class="px-3 py-1 text-sm rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                {tool}
              </span>
            ))}
          </div>
        </div>

        <!-- Scope -->
        <div class="mb-6">
          <p class="text-xs font-semibold text-teal uppercase tracking-wide mb-2">Testing Scope</p>
          <div class="flex flex-wrap gap-2">
            {scope.map((item) => (
              <span class="px-3 py-1 text-sm rounded-full bg-teal/10 text-teal font-medium">
                {item}
              </span>
            ))}
          </div>
        </div>

        <!-- Results Summary -->
        {results && results.length > 0 && (
          <div class="bg-slate-900 dark:bg-slate-800 rounded-xl p-6">
            <p class="text-xs font-semibold text-teal uppercase tracking-wide mb-4">Key Results</p>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              {results.map((result) => (
                <div class="text-center">
                  <p class="text-lg font-bold text-white">{result.value}</p>
                  <p class="text-xs text-slate-400 mt-1">{result.metric}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </header>

      <!-- Article Content -->
      <div class="prose prose-slate dark:prose-invert prose-lg max-w-none
        prose-headings:font-bold prose-headings:text-slate-800 dark:prose-headings:text-white
        prose-a:text-teal prose-a:no-underline hover:prose-a:underline
        prose-code:text-teal prose-code:bg-slate-100 dark:prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
        prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-700
        prose-img:rounded-lg prose-img:shadow-lg
        prose-table:border-collapse prose-th:bg-slate-100 dark:prose-th:bg-slate-800
        prose-td:border prose-td:border-slate-200 dark:prose-td:border-slate-700 prose-td:px-4 prose-td:py-2
        prose-th:border prose-th:border-slate-200 dark:prose-th:border-slate-700 prose-th:px-4 prose-th:py-2">
        <slot />
      </div>

      <!-- Back to Portfolio -->
      <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-700">
        <a href="/portfolio" class="inline-flex items-center text-teal hover:underline font-medium">
          <svg class="mr-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to all projects
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
