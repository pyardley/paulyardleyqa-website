---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
---

<BaseLayout title="Paul Yardley — QA Analyst & Test Engineer">
  <Hero />

  <!-- Highlights Section -->
  <section class="py-16 sm:py-24 bg-white dark:bg-slate-800/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-12 text-center">What I Do</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="bg-slate-100 dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:border-teal/50 transition-colors">
          <div class="w-12 h-12 rounded-lg bg-teal/10 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Test Strategy & Planning</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Designing comprehensive test strategies that balance coverage, speed, and risk. From exploratory testing to full regression suites.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="bg-slate-100 dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:border-teal/50 transition-colors">
          <div class="w-12 h-12 rounded-lg bg-teal/10 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Test Automation</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Building reliable, maintainable automation frameworks with Playwright, Cypress, and API testing tools. CI/CD integrated from day one.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="bg-slate-100 dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:border-teal/50 transition-colors">
          <div class="w-12 h-12 rounded-lg bg-teal/10 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Quality Advocacy</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Championing accessibility, performance, and security testing. Ensuring quality is everyone's responsibility, not just QA's.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Preview -->
  <SkillsMatrix />

  <!-- CTA Section -->
  <section class="py-16 sm:py-24 bg-gradient-to-r from-navy to-slate-800 dark:from-slate-950 dark:to-slate-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Let's work together</h2>
      <p class="text-slate-300 mb-8 text-lg">
        Looking for a QA professional who cares about quality as much as you do? Let's chat.
      </p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a
          href="/contact"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-teal text-white font-semibold hover:bg-teal-dark transition-colors shadow-lg shadow-teal/25"
        >
          Get In Touch
        </a>
        <a
          href="/portfolio"
          class="inline-flex items-center px-6 py-3 rounded-lg border-2 border-slate-500 text-slate-300 font-semibold hover:border-white hover:text-white transition-colors"
        >
          See My Work
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
