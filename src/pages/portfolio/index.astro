---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Portfolio — Paul Yardley QA" description="QA case studies and project highlights from Paul Yardley's career in software testing.">
  <section class="py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-slate-800 dark:text-white mb-4">Portfolio</h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 mb-12 max-w-2xl">
        Real-world case studies showcasing my testing strategies, tools, and measurable results.
      </p>

      <!-- Placeholder for Phase 2 content collection -->
      <div class="bg-slate-100 dark:bg-slate-800 rounded-xl p-12 text-center border-2 border-dashed border-slate-300 dark:border-slate-600">
        <p class="text-slate-500 dark:text-slate-400 text-lg">
          Case studies coming soon — Phase 2 content.
        </p>
        <p class="text-sm text-slate-400 dark:text-slate-500 mt-2">
          This section will feature detailed project write-ups with the testing strategy, tools used, and quantified results.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
