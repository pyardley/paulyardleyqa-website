---
---

<section class="relative overflow-hidden bg-gradient-to-br from-navy via-slate-800 to-navy dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40">
    <div class="max-w-3xl">
      <!-- Greeting -->
      <p class="text-teal font-mono text-sm sm:text-base mb-4">Hi, my name is</p>

      <!-- Name -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4">
        Paul Yardley
      </h1>

      <!-- Tagline -->
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-slate-300 mb-6">
        I break things so your users don't have to.
      </h2>

      <!-- Bio -->
      <p class="text-lg text-slate-400 max-w-2xl mb-8 leading-relaxed">
        QA Analyst & Test Engineer with a passion for building robust testing strategies,
        automating the tedious, and shipping software that actually works. Based in the UK.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap gap-4">
        <a
          href="/portfolio"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-teal text-white font-semibold hover:bg-teal-dark transition-colors shadow-lg shadow-teal/25"
        >
          View My Work
          <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="/resume"
          class="inline-flex items-center px-6 py-3 rounded-lg border-2 border-teal text-teal font-semibold hover:bg-teal/10 transition-colors"
        >
          Download CV
          <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center px-6 py-3 rounded-lg border-2 border-slate-500 text-slate-300 font-semibold hover:border-slate-400 hover:text-white transition-colors"
        >
          Get In Touch
        </a>
      </div>
    </div>
  </div>

  <!-- Decorative gradient orb -->
  <div class="absolute top-1/2 right-0 -translate-y-1/2 w-96 h-96 bg-teal/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
</section>
